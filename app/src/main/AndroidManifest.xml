<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".AnthuriaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Anthuria">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WelcomeActivity" />
        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity
            android:name=".Room3DActivity"
            android:configChanges="locale|layoutDirection|screenSize|orientation|keyboardHidden" />
        <activity android:name=".FurnitureGalleryActivity" />
        <activity android:name=".ModelViewerActivity" />
        <activity android:name=".ProjectListActivity" />
        <activity android:name=".AccountActivity" />

        <activity android:name=".MainActivity" />

        <activity android:name=".EditorActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".FavoritesActivity" />
        <activity android:name=".SettingActivity" />
        <activity android:name=".AiFurnitureActivity" />
        <activity
            android:name=".TextureBrowserActivity"
            android:exported="false" />

    </application>
</manifest>